{
    "dev": {
        "app_function": "lambda2.lambda_handler",
        "aws_region": "us-east-1",
        "profile_name": "default",
        "project_name": "procesar_html",
        "runtime": "python3.10",
        "s3_bucket": "infocasas",
        "keep_warm": false,
        "apigateway_enabled": false,
        "manage_roles": false,
        "role_name": "LabRole",
        "events": [
            {
                "function": "lambda2.lambda_handler",
                "event_source": {
                    "arn": "arn:aws:s3:::infocasas",
                    "events": ["s3:ObjectCreated:*"],
                    "filters": [
                        {
                            "Name": "prefix",
                            "Value": "landing-casas/"
                        },
                        {
                            "Name": "suffix",
                            "Value": ".html"
                        }
                    ]
                }
            }
        ]
    }
}
