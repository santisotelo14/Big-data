{
    "dev": {
        "app_function": "lambda2.process_mitula_html",
        "aws_region": "us-east-1",
        "profile_name": "default",
        "project_name": "procesar_html",
        "runtime": "python3.10",
        "s3_bucket": "infocasas",
        "keep_warm": false,
        "apigateway_enabled": false,
        "manage_roles": false,
        "role_name": "LabRole",
        "events": [
            {
                "function": "lambda2.process_mitula_html",
                "event_source": {
                    "arn": "arn:aws:s3:::infocasas",
                    "events": ["s3:ObjectCreated:*"]
                }
            }
        ]
    }
}
