{
    "dev": {
        "app_function": "lambda1.download_mitula_pages",
        "aws_region": "us-east-1",
        "exclude": [
            "boto3",
            "dateutil",
            "botocore",
            "s3transfer",
            "concurrent"
        ],
        "profile_name": "default",
        "project_name": "environment",
        "runtime": "python3.10",
        "s3_bucket": "mitula10",
        "keep_warm": false,
        "apigateway_enabled": false,
        "manage_roles": false,
        "role_name": "LabRole",
        "events": [
            {
                "function": "lambda1.download_mitula_pages",
                "expression": "cron(* * * * ? *)"
            }
        ]
    }
}